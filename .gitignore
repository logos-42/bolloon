# bolloon runtime data (本地运行态, 不入库; 技能/迁移/日志都在此)
.bolloon/

# Rokid vendor SDK stays outside the repository; ignore accidental local copies.
android/vendor/*
rokid/glass/vendor/*

# wrangler / Cloudflare Workers 本地生成物 (含本地 KV/D1 状态)
