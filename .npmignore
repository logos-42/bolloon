# Development
.git
.gitignore
.github
*.log
.env
.env.*
!.env.example

# Build artifacts that shouldn't be published
bin/ipfs
dist/test/
dist/electron*.js
dist/electron*.js.map
dist/*/tests/
dist/*/*.test.js
dist/*/*.test.js.map

# Local configs
.tsconfig*.json
tsconfig*.json
vitest.config.ts
.eslint*
.prettier*
jest*

# Build scripts (keep dist/ output only)
scripts/

# Lefthook / git hooks config
lefthook.yml

# Playwright test artifacts
.playwright-mcp/

# Source code artifacts (keep compiled dist only)
src/
**/*.ts
**/*.tsx
**/*.map

# Source test files
src/test/

# CI/CD
.github/
workflows/
.circleci/
.gitlab-ci*

# Documentation
docs/
findings.md
progress.md
task_plan.md
想法.md

# IPFS and temporary files
.ipfs/
.boll/
.port_sessions/
.DS_Store
*.tgz
*.log

# Auto-evolve artifacts (staging, baselines, call logs) — not for end users
staging/
test-results/
.auto-evolve-calls
.last-auto-evolve-baseline
.auto-evolve-*

# Stray research / scratch dirs that aren't part of the product
Dive-into/
Bolloon.md

# Exclude packages that should be built separately
py-bolloon/
.kilo/

# Electron specific
release/
.bolloon-logs

# Duplicate source from monorepo sub-packages (compiled into dist/ already)
src/constraint-runtime/
src/pi-ecosystem*/
