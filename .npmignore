# Development
.git
.gitignore
.github
*.md
coverage/
*.log
.env
.env.*
!.env.example

# Build artifacts that shouldn't be published
bin/ipfs
dist/test/
dist/electron*.js
dist/electron*.js.map
dist/*/tests/
dist/*/*.test.js
dist/*/*.test.js.map

# Local configs
.tsconfig*.json
vitest.config.ts
.eslint*
.prettier*
jest*

# Source code artifacts (keep compiled dist only)
src/*/package-lock.json
src/*/tsconfig.json
src/*/node_modules/
src/*/tests/
**/.claude/
**/.githooks/

# Source test files
src/test/

# CI/CD
.github/
workflows/
.circleci/
.gitlab-ci*

# Documentation
docs/
findings.md
progress.md
task_plan.md
想法.md

# IPFS and temporary files
.ipfs/
.boll/
.port_sessions/
.DS_Store
*.tgz
*.log

# Exclude packages that should be built separately
py-bolloon/
.kilo/

# Electron specific
release/

# Duplicate source from monorepo sub-packages (compiled into dist/ already)
src/constraint-runtime/
src/pi-ecosystem*/
