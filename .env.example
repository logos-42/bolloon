# Environment Configuration
# Copy this file to .env and fill in your values

# Minimax API Key (required for LLM summarization)
MINIMAX_API_KEY=your_minimax_api_key_here

# Bootstrap Peers for P2P network (comma-separated multiaddrs)
# Example: /ip4/192.168.1.100/tcp/4001/p2p/Qm...
BOOTSTRAP_PEERS=

# Auto-send threshold (0.0 - 1.0)
AUTO_SEND_THRESHOLD=0.7

# Port for local API server (optional, for future web frontend)
API_PORT=3000
