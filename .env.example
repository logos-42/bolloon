# Bolloon Agent —— 容器环境变量清单 (模板)
#
# ⚠️ 本文件**只有变量名与空值**, 按纪律**永远不放真实值**; 它可以直接入 git。
#    真值放哪、为什么:
#      1. 本机开发: 复制成 `.env` (已在 .gitignore 里, 不会入库), 填完用
#         `docker compose --env-file .env up -d` —— 注意 `.env` 里的值会进
#         `docker inspect` 可见的容器环境 (同机器上能跑 docker 的人都能读到);
#      2. 更安全: **不填这些变量**, 改成挂载配置文件
#         `-v $PWD/llm-config.json:/home/bolloon/.bolloon/llm-config.json:ro`
#         (Bolloon 的密钥事实源, 权限 0600)。这样密钥不进容器环境、不进镜像层、
#         也不会被 `docker inspect` / crash 报告带出去。**推荐这条**。
#      3. 生产编排: 用 `docker secret` / 外部 KMS, 不要写进 compose 的明文 env。
#
# 复制后按需填写, 空的变量等于"没设置", 不会覆盖配置文件里的值。

# ── 服务面 ─────────────────────────────────────────────────────────
# Web 服务端口 (src/index.ts 只认这个变量, `--port` 参数不解析)
PORT=
# 状态目录 (契约: BOLLOON_HOME 优先, 否则 $HOME/.bolloon)
BOLLOON_HOME=
# bind 地址。容器里必须是 0.0.0.0 才能被端口映射打到; 默认只监听 127.0.0.1
BOLLOON_HOST=

# ── LLM 选择与行为 ────────────────────────────────────────────────
# 显式指定供应商 (否则按 key 是否存在自动挑)
BOLLOON_LLM_PROVIDER=
# 单次 LLM 请求超时 (毫秒)
BOLLOON_LLM_TIMEOUT=
# 关掉 prompt 缓存 (调试用)
BOLLOON_DISABLE_CACHE_PROMPT=
# prompt 装配档位
BOLLOON_PROMPT_PROFILE=
# 给 prompt 加前缀 (只在调试时开)
DEBUG_PROMPT_PREFIX=
# 把请求体落盘 (排查上游 4xx 用; 会写文件, 默认关)
BOLLOON_DUMP_BODY=

# ── 前缀 KV 复用 (2026-09-28) ──────────────────────────────────────
# 语义见 docs/wiki/kv-prefix-cache.md: 只有 main-agent 带 cache_prompt, 且只对本机 endpoint 带
# 本地 llama.cpp (OpenAI 兼容服务): 设了 BASE_URL 就按 llamacpp 走; key 可空 (空时不带鉴权头)
LLAMACPP_BASE_URL=
LLAMACPP_MODEL=

# ── 运行/诊断开关 (可选) ───────────────────────────────────────────
# 启动期前言逐字上屏 (默认静默)
BOLLOON_VERBOSE=
BOLLOON_STARTUP_PREAMBLE=
# 只诊断不改状态: 未初始化时不进向导、也不放行 agent 执行
BOLLOON_SKIP_SETUP=
# 跳过 P2P/Kubo 相关组件 (离线或受限网络里更省事)
BOLLOON_SKIP_KUBO=
# 关掉自动更新检查
BOLLOON_SKIP_UPDATE=

# ── 各 provider 凭证 (全部留空) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
GLM_API_KEY=
GLM_BASE_URL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=
QWEN_API_KEY=
QWEN_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
GEMINI_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=
OLLAMA_BASE_URL=
LLAMACPP_API_KEY=
LLAMACPP_BASE_URL=

# ── 钱包 / 链上 (慎填: 私钥类变量名单独列出, 值一律留空) ───────────
# 容器跑在共享宿主机上时, 私钥进 env = 任何能 `docker inspect` 的人都拿得到;
# 要用链上能力, 优先用 0600 的配置文件挂载, 或外部签名服务。
BOLLOON_WALLET_PRIVATE_KEY=
BOLLOON_TREASURY_KEY=
BOLLOON_SESSION_KEY=
BOLLOON_CHAIN_RPC_URL=
BOLLOON_CHAIN_ID=
