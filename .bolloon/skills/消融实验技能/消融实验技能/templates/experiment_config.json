{
  "_说明": "消融实验配置模板——基于C1-C8标准结构",
  "_使用方法": "复制此文件,修改experiment_name和mechanisms部分",
  
  "experiment_name": "消融实验_v1",
  "description": "验证机制A和机制B的贡献",
  "created_at": "2025-01-01",
  
  "dataset": {
    "vocab_size": 10000,
    "read_window": 2,
    "train_size": 10000,
    "test_size": 1000
  },
  
  "model": {
    "type": "SSM-GRU",
    "hidden_size": 256,
    "num_layers": 2
  },
  
  "mechanisms": {
    "mechanism_a": {
      "name": "机制A",
      "description": "描述机制A的作用",
      "enabled": true
    },
    "mechanism_b": {
      "name": "机制B",
      "description": "描述机制B的作用",
      "enabled": true
    }
  },
  
  "ablation_configs": {
    "C1-baseline": {
      "description": "基准:无任何机制",
      "mechanism_a": false,
      "mechanism_b": false
    },
    "C2-仅A": {
      "description": "仅机制A",
      "mechanism_a": true,
      "mechanism_b": false
    },
    "C3-仅B": {
      "description": "仅机制B",
      "mechanism_a": false,
      "mechanism_b": true
    },
    "C8-all": {
      "description": "全机制",
      "mechanism_a": true,
      "mechanism_b": true
    }
  },
  
  "evaluation": {
    "primary_metric": "cf_acc",
    "secondary_metrics": ["pos_decl_full"],
    "constraint_metrics": {
      "PPL_max": 500,
      "PPL_min": 10
    },
    "success_thresholds": {
      "success": 0.05,
      "partial_success": 0.02,
      "false_positive_multiplier": 10
    }
  },
  
  "training": {
    "epochs": 100,
    "batch_size": 32,
    "learning_rate": 0.001,
    "early_stopping_patience": 10
  }
}
