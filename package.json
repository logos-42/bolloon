{
  "name": "balloon-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "P2P AI Document Agent with libp2p",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:main": "tsc",
    "build:web": "npx tsx scripts/build-web.ts",
    "start": "node dist/index.js",
    "dev": "tsx -r dotenv/config src/index.ts",
    "dev:web": "npm run build:web && npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pi-sdk": "tsx src/test/pi-sdk.test.ts"
  },
  "workspaces": [
    "src/constraint-runtime"
  ],
  "dependencies": {
    "@bolloon/constraint-runtime": "0.1.0",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@diap/sdk": "^0.1.9",
    "@libp2p/autonat": "^3.0.20",
    "@libp2p/circuit-relay-v2": "^4.2.5",
    "@libp2p/dcutr": "^3.0.20",
    "@libp2p/identify": "^4.1.6",
    "@libp2p/kad-dht": "^16.2.6",
    "@libp2p/tcp": "^11.0.20",
    "@libp2p/upnp-nat": "^4.0.20",
    "@multiformats/multiaddr": "^13.0.3",
    "@noble/hashes": "^1.3.0",
    "@rayhanadev/iroh": "^0.1.1",
    "@twind/core": "^1.1.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.24.0",
    "express": "^5.2.1",
    "libp2p": "^3.3.0",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
