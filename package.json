{
  "name": "@bolloon/bolloon-agent",
  "version": "0.2.1",
  "type": "module",
  "description": "P2P AI Document Agent - 全局安装后执行 `bolloon` 启动产品",
  "main": "dist/cli.js",
  "author": "Bolloon Team",
  "bin": {
    "bolloon": "./bin/bolloon-cli.cjs"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:main": "tsc",
    "build:cli": "node scripts/build-cli.js",
    "build:web": "npx tsx scripts/build-web.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:all": "npm run build:main && npm run build:web && npm run build:electron && npm run build:cli",
    "start": "node dist/index.js",
    "dev": "tsx -r dotenv/config src/index.ts",
    "dev:web": "npm run build:web && tsx -r dotenv/config src/index.ts --web",
    "dev:electron": "npm run build:electron && npm run electron:start",
    "electron:start": "NODE_ENV=development electron dist/electron.js",
    "electron:dev": "concurrently \"npm run dev:web\" \"npm run electron:start\"",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:pack": "electron-builder --dir",
    "app:bundle": "node scripts/build-app-bundle.cjs",
    "app:bundle:open": "node scripts/build-app-bundle.cjs && open \"release/mac-arm64/Bolloon Agent.app\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pi-sdk": "tsx src/test/pi-sdk.test.ts",
    "postinstall": "node scripts/postinstall.js"
  },
  "workspaces": [
    "src/constraint-runtime"
  ],
  "dependencies": {
    "@bolloon/bolloon-agent": "^0.1.36",
    "@bolloon/constraint-runtime": "0.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@diap/sdk": "^0.1.10",
    "@libp2p/autonat": "^3.0.20",
    "@libp2p/circuit-relay-v2": "^4.2.5",
    "@libp2p/dcutr": "^3.0.20",
    "@libp2p/identify": "^4.1.6",
    "@libp2p/kad-dht": "^16.2.6",
    "@libp2p/tcp": "^11.0.20",
    "@libp2p/upnp-nat": "^4.0.20",
    "@multiformats/multiaddr": "^13.0.3",
    "@noble/hashes": "^1.3.0",
    "@rayhanadev/iroh": "^0.1.1",
    "b4a": "^1.8.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.24.0",
    "express": "^5.2.1",
    "libp2p": "^3.3.0",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.4",
    "platform": "^1.3.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.2.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.5",
    "lefthook": "^2.1.9",
    "playwright": "^1.60.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.bolloon.agent",
    "productName": "Bolloon Agent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "bin/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist/electron.js",
      "type": "commonjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@diap/**/*",
      "node_modules/@rayhanadev/**/*",
      "node_modules/libp2p/**/*",
      "node_modules/@libp2p/**/*"
    ]
  }
}
